# Copy to .env (gitignored) and fill in. Produced by the Entra automation.

# The toggle. true = Entra sign-in + user/group sync; restart to apply.
ENTRA_ENABLED=false

# Entra tenant and the Backstage app registration
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=change-me

# Random, 32+ characters; signs Backstage's OAuth session cookies.
AUTH_SESSION_SECRET=change-me

# Microsoft Graph OData filters for what gets ingested into the catalog.
ENTRA_USER_FILTER=accountEnabled eq true and userType eq 'Member'
ENTRA_GROUP_FILTER=startswith(displayName,'phoenix-')
