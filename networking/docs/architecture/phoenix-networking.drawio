<mxfile host="drawio"><diagram id="networking" name="Phoenix networking"><mxGraphModel dx="2600" dy="1400" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2600" pageHeight="1400" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Phoenix networking on AWS — hub and spoke, on demand&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;a region's transit gateway is created with its first environment · production and non-production never meet · the tooling VPC reaches both&lt;/span&gt;" style="text;html=1;fontSize=24;fontColor=#232F3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2000" height="56" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F1F5FB;strokeColor=#1F5FBF;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="400" height="640" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=18;fillColor=#121212;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="54" y="120" width="42" height="42" as="geometry"/></mxCell><mxCell id="c5" value="" style="verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;shape=image;imageAspect=0;image=data:image/svg+xml,;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="126" width="30" height="30" as="geometry"/></mxCell><mxCell id="c6" value="Backstage" style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#1F5FBF;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="106" y="128" width="300" height="24" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;platform.yaml&lt;/b&gt; — the adopter decides once&lt;br&gt;hub region(s) · address space · segment / region / VPC sizes&lt;br&gt;egress mode: central | independent&lt;br&gt;hybrid: none | vpn | dx_vpn | dual_dx&lt;br&gt;on-prem CIDRs · DNS forwarding · share with" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="176" width="360" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Environment form&lt;/b&gt;&lt;br&gt;the requester picks a region and a tier — never networking" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="304" width="360" height="56" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Region has a network?&lt;/b&gt; (phoenix-region entity)&lt;br&gt;no → write networking units first:&lt;br&gt;① ipam.yaml (+ region) → ② region.yaml →&lt;br&gt;③ peering.&amp;lt;peer&amp;gt;.yaml for every region → ④ entity" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFF8E7;strokeColor=#B07A00;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="378" width="360" height="96" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Then the environment, as today&lt;/b&gt;&lt;br&gt;core-network (attach, segment from tier) → core-platform → …" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="492" width="360" height="56" as="geometry"/></mxCell><mxCell id="c11" value="" style="verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;shape=image;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="66" y="572" width="26" height="26" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;GitHub Actions&lt;/b&gt; — one workflow, networking/ added&lt;br&gt;networking units run on GitHub-hosted runners" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#24292F;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="104" y="566" width="316" height="56" as="geometry"/></mxCell><mxCell id="c13" value="Requesters see none of this: a missing region is built first, then their request carries on." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#545B64;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="360" height="60" as="geometry"/></mxCell><mxCell id="c14" value="Tooling account" style="points=[];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#E7157B;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#E7157B;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="400" height="330" as="geometry"/></mxCell><mxCell id="c15" value="Tooling VPC · hub region · shared segment" style="points=[];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="360" height="270" as="geometry"/></mxCell><mxCell id="c16" value="" style="rounded=1;arcSize=18;fillColor=#121212;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="84" y="874" width="46" height="46" as="geometry"/></mxCell><mxCell id="c17" value="" style="verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;shape=image;imageAspect=0;image=data:image/svg+xml,;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="90" y="880" width="34" height="34" as="geometry"/></mxCell><mxCell id="c18" value="Backstage" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#545B64;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="140" y="888" width="120" height="24" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;phoenix-mgmt runner&lt;/b&gt;&lt;br&gt;reaches every cluster's private&lt;br&gt;EKS API, in every region" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#24292F;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="80" y="940" width="300" height="66" as="geometry"/></mxCell><mxCell id="c20" value="attachment&lt;br&gt;→ shared" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=none;fillColor=#8C4FFF;pointerEvents=1;shape=mxgraph.aws4.transit_gateway_attachment;" vertex="1" parent="1"><mxGeometry x="340" y="1030" width="44" height="44" as="geometry"/></mxCell><mxCell id="c21" value="Networking account — owns every transit gateway, IPAM, egress, hybrid, DNS" style="points=[];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#E7157B;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#E7157B;dashed=0;" vertex="1" parent="1"><mxGeometry x="480" y="110" width="1540" height="1000" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;IPAM&lt;/b&gt; (delegated admin) — one summary route per segment&lt;br&gt;address space, e.g. 10.64.0.0/10&lt;br&gt;├ &lt;font color='#D13212'&gt;&lt;b&gt;production&lt;/b&gt;&lt;/font&gt; 10.64.0.0/12 → one /16 per region, on demand&lt;br&gt;├ &lt;font color='#1F7A3E'&gt;&lt;b&gt;non-production&lt;/b&gt;&lt;/font&gt; 10.80.0.0/12 → one /16 per region&lt;br&gt;├ &lt;font color='#8C4FFF'&gt;&lt;b&gt;shared&lt;/b&gt;&lt;/font&gt; 10.96.0.0/12 → tooling · hub DNS · egress VPCs&lt;br&gt;└ reserved" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="510" y="150" width="700" height="140" as="geometry"/></mxCell><mxCell id="c23" value="" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=#ffffff;fillColor=#8C4FFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.vpc;" vertex="1" parent="1"><mxGeometry x="1130" y="160" width="48" height="48" as="geometry"/></mxCell><mxCell id="c24" value="Hub region (platform setting) — always exists" style="points=[];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#00A4A6;dashed=1;" vertex="1" parent="1"><mxGeometry x="510" y="320" width="700" height="540" as="geometry"/></mxCell><mxCell id="c25" value="hub transit gateway" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=none;fillColor=#8C4FFF;pointerEvents=1;shape=mxgraph.aws4.transit_gateway;" vertex="1" parent="1"><mxGeometry x="780" y="390" width="64" height="64" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;production&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FDECEA;strokeColor=#D13212;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingTop=2;align=center;" vertex="1" parent="1"><mxGeometry x="890" y="370" width="150" height="30" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;non-production&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#E9F5EC;strokeColor=#1F7A3E;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingTop=2;align=center;" vertex="1" parent="1"><mxGeometry x="890" y="408" width="150" height="30" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;shared&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F3EDFF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingTop=2;align=center;" vertex="1" parent="1"><mxGeometry x="890" y="446" width="150" height="30" as="geometry"/></mxCell><mxCell id="c29" value="Egress VPC (central mode)" style="points=[];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;dashed=1;" vertex="1" parent="1"><mxGeometry x="530" y="550" width="250" height="140" as="geometry"/></mxCell><mxCell id="c30" value="NAT" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=none;fillColor=#8C4FFF;pointerEvents=1;shape=mxgraph.aws4.nat_gateway;" vertex="1" parent="1"><mxGeometry x="560" y="600" width="44" height="44" as="geometry"/></mxCell><mxCell id="c31" value="IGW" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=none;fillColor=#8C4FFF;pointerEvents=1;shape=mxgraph.aws4.internet_gateway;" vertex="1" parent="1"><mxGeometry x="660" y="600" width="44" height="44" as="geometry"/></mxCell><mxCell id="c32" value="Hub DNS VPC (hybrid / forwarding)" style="points=[];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;dashed=1;" vertex="1" parent="1"><mxGeometry x="900" y="550" width="290" height="140" as="geometry"/></mxCell><mxCell id="c33" value="Resolver&lt;br&gt;inbound · outbound" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=#ffffff;fillColor=#8C4FFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;" vertex="1" parent="1"><mxGeometry x="930" y="592" width="48" height="48" as="geometry"/></mxCell><mxCell id="c34" value="forwarding rules shared by RAM&lt;br&gt;env internal zones associated" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#545B64;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1020" y="600" width="160" height="60" as="geometry"/></mxCell><mxCell id="c35" value="Site-to-site VPN&lt;br&gt;2 IPsec tunnels" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=none;fillColor=#8C4FFF;pointerEvents=1;shape=mxgraph.aws4.vpn_connection;" vertex="1" parent="1"><mxGeometry x="552" y="740" width="48" height="48" as="geometry"/></mxCell><mxCell id="c36" value="Direct Connect gateway" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=#ffffff;fillColor=#8C4FFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.direct_connect;" vertex="1" parent="1"><mxGeometry x="700" y="740" width="48" height="48" as="geometry"/></mxCell><mxCell id="c37" value="hybrid: vpn · dx_vpn · dual_dx&lt;br&gt;attached in &lt;b&gt;shared&lt;/b&gt;; BGP&lt;br&gt;propagates on-prem routes" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#545B64;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="930" y="740" width="260" height="60" as="geometry"/></mxCell><mxCell id="c38" value="Region B — created with its first environment" style="points=[];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#00A4A6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1260" y="150" width="730" height="430" as="geometry"/></mxCell><mxCell id="c39" value="regional&lt;br&gt;transit gateway" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=none;fillColor=#8C4FFF;pointerEvents=1;shape=mxgraph.aws4.transit_gateway;" vertex="1" parent="1"><mxGeometry x="1540" y="210" width="64" height="64" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;production&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FDECEA;strokeColor=#D13212;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingTop=2;align=center;" vertex="1" parent="1"><mxGeometry x="1650" y="262" width="150" height="30" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;non-production&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#E9F5EC;strokeColor=#1F7A3E;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingTop=2;align=center;" vertex="1" parent="1"><mxGeometry x="1650" y="300" width="150" height="30" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;shared&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F3EDFF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingTop=2;align=center;" vertex="1" parent="1"><mxGeometry x="1650" y="338" width="150" height="30" as="geometry"/></mxCell><mxCell id="c43" value="Egress VPC (central mode)" style="points=[];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;dashed=1;" vertex="1" parent="1"><mxGeometry x="1290" y="360" width="300" height="140" as="geometry"/></mxCell><mxCell id="c44" value="NAT" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=none;fillColor=#8C4FFF;pointerEvents=1;shape=mxgraph.aws4.nat_gateway;" vertex="1" parent="1"><mxGeometry x="1320" y="410" width="44" height="44" as="geometry"/></mxCell><mxCell id="c45" value="IGW" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=none;fillColor=#8C4FFF;pointerEvents=1;shape=mxgraph.aws4.internet_gateway;" vertex="1" parent="1"><mxGeometry x="1420" y="410" width="44" height="44" as="geometry"/></mxCell><mxCell id="c46" value="+ 3 regional IPAM pools&lt;br&gt;never removed automatically" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#545B64;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1660" y="400" width="300" height="50" as="geometry"/></mxCell><mxCell id="c47" value="Region C — the next one, on demand" style="points=[];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#00A4A6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1260" y="610" width="730" height="250" as="geometry"/></mxCell><mxCell id="c48" value="regional&lt;br&gt;transit gateway" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=none;fillColor=#8C4FFF;pointerEvents=1;shape=mxgraph.aws4.transit_gateway;" vertex="1" parent="1"><mxGeometry x="1540" y="660" width="64" height="64" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;production&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FDECEA;strokeColor=#D13212;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingTop=2;align=center;" vertex="1" parent="1"><mxGeometry x="1650" y="640" width="150" height="30" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;non-production&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#E9F5EC;strokeColor=#1F7A3E;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingTop=2;align=center;" vertex="1" parent="1"><mxGeometry x="1650" y="678" width="150" height="30" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;shared&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F3EDFF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingTop=2;align=center;" vertex="1" parent="1"><mxGeometry x="1650" y="716" width="150" height="30" as="geometry"/></mxCell><mxCell id="c52" value="peers with both hubs and every region already there (full mesh)" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#545B64;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1290" y="790" width="680" height="30" as="geometry"/></mxCell><mxCell id="c53" value="Second hub region (only with dual_dx)" style="points=[];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#00A4A6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1260" y="890" width="730" height="200" as="geometry"/></mxCell><mxCell id="c54" value="second hub&lt;br&gt;transit gateway" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=none;fillColor=#8C4FFF;pointerEvents=1;shape=mxgraph.aws4.transit_gateway;" vertex="1" parent="1"><mxGeometry x="1540" y="940" width="64" height="64" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;production&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FDECEA;strokeColor=#D13212;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingTop=2;align=center;" vertex="1" parent="1"><mxGeometry x="1650" y="930" width="150" height="30" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;non-production&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#E9F5EC;strokeColor=#1F7A3E;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingTop=2;align=center;" vertex="1" parent="1"><mxGeometry x="1650" y="968" width="150" height="30" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;shared&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F3EDFF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingTop=2;align=center;" vertex="1" parent="1"><mxGeometry x="1650" y="1006" width="150" height="30" as="geometry"/></mxCell><mxCell id="c58" value="same Direct Connect gateway, second connection&lt;br&gt;peers with every transit gateway, like the hub" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#545B64;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1290" y="1040" width="680" height="40" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;On every transit gateway&lt;/b&gt;&lt;br&gt;&lt;font color='#D13212'&gt;&lt;b&gt;production&lt;/b&gt;&lt;/font&gt;: prod VPCs · learns prod + tooling · &lt;b&gt;blackhole&lt;/b&gt; non-production · (central) 0/0 → egress&lt;br&gt;&lt;font color='#1F7A3E'&gt;&lt;b&gt;non-production&lt;/b&gt;&lt;/font&gt;: sandbox · stage · uat · &lt;b&gt;blackhole&lt;/b&gt; production · (central) 0/0 → egress&lt;br&gt;&lt;font color='#8C4FFF'&gt;&lt;b&gt;shared&lt;/b&gt;&lt;/font&gt;: tooling, DNS, egress, on-prem, peerings · reaches everything&lt;br&gt;peering: static routes per segment block, both sides" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FAFAFA;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1260" y="1160" width="730" height="130" as="geometry"/></mxCell><mxCell id="c60" value="Group account — production" style="points=[];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#E7157B;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#E7157B;dashed=0;" vertex="1" parent="1"><mxGeometry x="2060" y="110" width="500" height="360" as="geometry"/></mxCell><mxCell id="c61" value="prod VPC · region B · production segment" style="points=[];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#D13212;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#D13212;dashed=0;" vertex="1" parent="1"><mxGeometry x="2080" y="150" width="460" height="300" as="geometry"/></mxCell><mxCell id="c62" value="EKS + Cilium" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=#ffffff;fillColor=#ED7100;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" vertex="1" parent="1"><mxGeometry x="2120" y="210" width="56" height="56" as="geometry"/></mxCell><mxCell id="c63" value="NAT (independent&lt;br&gt;mode only)" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=none;fillColor=#8C4FFF;pointerEvents=1;shape=mxgraph.aws4.nat_gateway;" vertex="1" parent="1"><mxGeometry x="2320" y="210" width="44" height="44" as="geometry"/></mxCell><mxCell id="c64" value="attachment&lt;br&gt;→ production" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=none;fillColor=#8C4FFF;pointerEvents=1;shape=mxgraph.aws4.transit_gateway_attachment;" vertex="1" parent="1"><mxGeometry x="2120" y="340" width="44" height="44" as="geometry"/></mxCell><mxCell id="c65" value="Group account — non-production" style="points=[];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#E7157B;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#E7157B;dashed=0;" vertex="1" parent="1"><mxGeometry x="2060" y="500" width="500" height="360" as="geometry"/></mxCell><mxCell id="c66" value="sandbox VPC · region B · non-production segment" style="points=[];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#1F7A3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#1F7A3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="2080" y="540" width="460" height="300" as="geometry"/></mxCell><mxCell id="c67" value="EKS + Cilium" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=#ffffff;fillColor=#ED7100;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" vertex="1" parent="1"><mxGeometry x="2120" y="600" width="56" height="56" as="geometry"/></mxCell><mxCell id="c68" value="NAT (independent&lt;br&gt;mode only)" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=none;fillColor=#8C4FFF;pointerEvents=1;shape=mxgraph.aws4.nat_gateway;" vertex="1" parent="1"><mxGeometry x="2320" y="600" width="44" height="44" as="geometry"/></mxCell><mxCell id="c69" value="attachment&lt;br&gt;→ non-production" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=none;fillColor=#8C4FFF;pointerEvents=1;shape=mxgraph.aws4.transit_gateway_attachment;" vertex="1" parent="1"><mxGeometry x="2120" y="730" width="44" height="44" as="geometry"/></mxCell><mxCell id="c70" value="&lt;b&gt;Cilium&lt;/b&gt; (k8s-installs baseline, chained with the VPC CNI)&lt;br&gt;default: own VPC · tooling · DNS · Pod Identity · internet&lt;br&gt;everything else private is denied until a policy opens it&lt;br&gt;(spec.egress_allow · team CiliumNetworkPolicies, FQDN rules)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2060" y="880" width="500" height="110" as="geometry"/></mxCell><mxCell id="c71" value="Teams are not separated by AWS routing: within a segment any VPC can route to any other; Cilium decides." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#545B64;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="2060" y="1000" width="500" height="60" as="geometry"/></mxCell><mxCell id="c72" value="Corporate data centre — the adopter's (optional)" style="points=[];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#5A6C86;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6C86;dashed=0;" vertex="1" parent="1"><mxGeometry x="480" y="1160" width="700" height="200" as="geometry"/></mxCell><mxCell id="c73" value="&lt;b&gt;Edge device + firewall&lt;/b&gt;&lt;br&gt;decides what on-prem reaches in each segment" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="510" y="1210" width="330" height="60" as="geometry"/></mxCell><mxCell id="c74" value="&lt;b&gt;DNS servers&lt;/b&gt;&lt;br&gt;forward AWS zones → Resolver inbound" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="860" y="1210" width="290" height="60" as="geometry"/></mxCell><mxCell id="c75" value="on-prem CIDRs must not overlap the address space · AWS advertises the three segment summaries" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#545B64;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="510" y="1290" width="640" height="40" as="geometry"/></mxCell><mxCell id="c76" value="&lt;b&gt;Egress modes&lt;/b&gt; (platform setting)&lt;br&gt;&lt;b&gt;central&lt;/b&gt;: env VPCs have no NAT; 0/0 → transit gateway → region's egress VPC&lt;br&gt;&lt;b&gt;independent&lt;/b&gt;: each VPC its own NAT; no default route on the transit gateway&lt;br&gt;either way, inbound load balancers use the VPC's own IGW" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2060" y="1100" width="500" height="110" as="geometry"/></mxCell><mxCell id="c77" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fo