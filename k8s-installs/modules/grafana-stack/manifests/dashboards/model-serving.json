{
  "uid": "phoenix-model-serving",
  "title": "Model serving",
  "tags": [
    "phoenix",
    "model-serving"
  ],
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "model host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": "label_values(istio_requests_total, request_host)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second, by model and consumer",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (request_host, consumer) (rate(istio_requests_total{request_host=~\"$model.*\"}[5m]))",
          "legendFormat": "{{request_host}} \u00b7 {{consumer}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 latency, by model and consumer",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.95, sum by (le, request_host, consumer) (rate(istio_request_duration_milliseconds_bucket{request_host=~\"$model.*\"}[5m])))",
          "legendFormat": "{{request_host}} \u00b7 {{consumer}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tokens per second, by model",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (model_name) (rate(vllm:prompt_tokens_total[5m]))",
          "legendFormat": "{{model_name}} prompt"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (model_name) (rate(vllm:generation_tokens_total[5m]))",
          "legendFormat": "{{model_name}} generated"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Time to first token p95, by model",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.95, sum by (le, model_name) (rate(vllm:time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "{{model_name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Model start time (created \u2192 Ready)",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (pod) (kube_pod_status_ready_time{namespace=\"models\", pod=~\"vllm-.*\"} - kube_pod_created{namespace=\"models\", pod=~\"vllm-.*\"})",
          "legendFormat": "{{pod}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (pod) ((time() - kube_pod_created{namespace=\"models\", pod=~\"vllm-.*\"}) and on (pod) (kube_pod_status_ready{namespace=\"models\", condition=\"false\"} == 1))",
          "legendFormat": "{{pod}} (still starting)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pending model pods, by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (reason) (kube_pod_container_status_waiting_reason{namespace=\"models\"})",
          "legendFormat": "{{reason}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum (kube_pod_status_unschedulable{namespace=\"models\"})",
          "legendFormat": "unschedulable (waiting for capacity)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (nodepool, phase) (karpenter_pods_state{namespace=\"models\", phase=\"Pending\"})",
          "legendFormat": "karpenter {{nodepool}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Accelerator utilisation",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "avg by (pod) (DCGM_FI_DEV_GPU_UTIL{namespace=\"models\"})",
          "legendFormat": "GPU {{pod}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "100 * avg by (instance_id) (neuroncore_utilization_ratio)",
          "legendFormat": "Neuron {{instance_id}}"
        }
      ]
    }
  ]
}