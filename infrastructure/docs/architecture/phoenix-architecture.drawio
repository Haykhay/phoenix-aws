<mxfile host="drawio"><diagram id="phoenix" name="Phoenix architecture"><mxGraphModel dx="2700" dy="1400" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2700" pageHeight="1520" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Phoenix on AWS — self-service environments and workloads&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Backstage takes the request · GitHub holds the YAML and runs plain Terraform · one AWS account per group · apps and AI on EKS&lt;/span&gt;" style="text;html=1;fontSize=24;fontColor=#232F3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="56" as="geometry"/></mxCell><mxCell id="c3" value="People" style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#232F3E;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="180" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Group members&lt;br&gt;developers · engineers&lt;br&gt;researchers" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=none;fillColor=#232F3D;pointerEvents=1;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="85" y="170" width="64" height="64" as="geometry"/></mxCell><mxCell id="c5" value="Engineering manager&lt;br&gt;approves group schedules" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=none;fillColor=#232F3D;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="90" y="420" width="56" height="56" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F1F5FB;strokeColor=#1F5FBF;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="460" height="560" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=18;fillColor=#121212;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="120" width="42" height="42" as="geometry"/></mxCell><mxCell id="c8" value="" style="verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;shape=image;imageAspect=0;image=data:image/svg+xml,;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="300" y="126" width="30" height="30" as="geometry"/></mxCell><mxCell id="c9" value="Backstage — own repo, fronts every cloud" style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#1F5FBF;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="346" y="128" width="380" height="24" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Forms&lt;/b&gt;&lt;br&gt;environment: tier · resource sets → infrastructure units&lt;br&gt;workload: type · database · GPU · model → k8s-installs units" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="300" y="180" width="420" height="70" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Catalog&lt;/b&gt;&lt;br&gt;account registry (account ID · state bucket) · clusters&lt;br&gt;components (dependsOn) · workload types · databases · GPUs · models" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="300" y="264" width="420" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Orchestrator&lt;/b&gt; (to build)&lt;br&gt;infrastructure: ① core-network → ② core-platform → ③ data-*&lt;br&gt;k8s-installs: components in dependsOn order · destroy in reverse · notify when ready" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="300" y="348" width="420" height="84" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Lifecycle&lt;/b&gt;&lt;br&gt;personal sandbox: torn down Friday evening or when idle&lt;br&gt;group schedule (manager-approved): up Monday, down Friday&lt;br&gt;LongLive: kept" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="300" y="446" width="420" height="84" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;GitHub App&lt;/b&gt;&lt;br&gt;opens the PR · merges sandbox PRs itself (ruleset bypass)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="300" y="544" width="420" height="56" as="geometry"/></mxCell><mxCell id="c15" value="" style="verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;shape=image;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="306" y="618" width="22" height="22" as="geometry"/></mxCell><mxCell id="c16" value="Grafana plugin: each environment's dashboards next to the environment" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#545B64;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="336" y="618" width="380" height="40" as="geometry"/></mxCell><mxCell id="c17" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FDF2F8;strokeColor=#E7157B;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="280" y="730" width="460" height="300" as="geometry"/></mxCell><mxCell id="c18" value="Account vending — separate repo / workflow" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#E7157B;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="742" width="330" height="24" as="geometry"/></mxCell><mxCell id="c19" value="CloudFormation&lt;br&gt;StackSets" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=#ffffff;fillColor=#E7157B;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;" vertex="1" parent="1"><mxGeometry x="320" y="800" width="56" height="56" as="geometry"/></mxCell><mxCell id="c20" value="AWS Organizations&lt;br&gt;new group account" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=#ffffff;fillColor=#E7157B;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.organizations;" vertex="1" parent="1"><mxGeometry x="480" y="800" width="56" height="56" as="geometry"/></mxCell><mxCell id="c21" value="DynamoDB&lt;br&gt;account registry" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=#ffffff;fillColor=#C925D1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="640" y="800" width="56" height="56" as="geometry"/></mxCell><mxCell id="c22" value="Runs first when a group has no account yet: creates the account, its S3 state bucket and deploy role, and records them in DynamoDB. Backstage reads the registry into its constants." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#545B64;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="300" y="940" width="420" height="70" as="geometry"/></mxCell><mxCell id="c23" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F6F8FA;strokeColor=#24292F;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="440" height="920" as="geometry"/></mxCell><mxCell id="c24" value="" style="verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;shape=image;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="900" y="124" width="32" height="32" as="geometry"/></mxCell><mxCell id="c25" value="GitHub" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#24292F;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="942" y="128" width="200" height="24" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Repo: phoenix-aws&lt;/b&gt; — one YAML file per unit&lt;br&gt;&lt;br&gt;&lt;b&gt;infrastructure/&lt;/b&gt; (Layer 2)&lt;br&gt;&amp;nbsp;&amp;nbsp;environments/&amp;lt;tier&amp;gt;/&amp;lt;env_id&amp;gt;/&amp;lt;scope&amp;gt;/&amp;lt;set&amp;gt;.yaml&lt;br&gt;&amp;nbsp;&amp;nbsp;context · core-network · core-platform · dns&lt;br&gt;&amp;nbsp;&amp;nbsp;data-rds/-elasticache/-msk · ecr · observability&lt;br&gt;&lt;br&gt;&lt;b&gt;k8s-installs/&lt;/b&gt; (Layer 3)&lt;br&gt;&amp;nbsp;&amp;nbsp;…/&amp;lt;region&amp;gt;/&amp;lt;cluster&amp;gt;/&amp;lt;component&amp;gt;[.&amp;lt;instance&amp;gt;].yaml&lt;br&gt;&amp;nbsp;&amp;nbsp;baseline: Karpenter · kyverno · falco · secrets · Grafana&lt;br&gt;&amp;nbsp;&amp;nbsp;service: Istio · cert-manager · external-dns · Argo CD · Kargo&lt;br&gt;&amp;nbsp;&amp;nbsp;AI: GPU pools · GPU operator · vLLM · Langfuse&lt;br&gt;&amp;nbsp;&amp;nbsp;databases: Postgres · Valkey · Kafka (sandbox)&lt;br&gt;&lt;br&gt;&lt;b&gt;Approval&lt;/b&gt; sandbox: merged by Backstage&lt;br&gt;&amp;nbsp;&amp;nbsp;stage / UAT / prod: Backstage groups (later)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="900" y="176" width="400" height="400" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;GitHub Actions — terraform.yml&lt;/b&gt;&lt;br&gt;&lt;br&gt;pull_request: &lt;i&gt;plan&lt;/i&gt; each changed YAML&lt;br&gt;workflow_dispatch: &lt;i&gt;plan | apply | destroy&lt;/i&gt; one YAML&lt;br&gt;&lt;br&gt;1. checkout YAML (main) + modules at module_ref&lt;br&gt;2. OIDC → Terraform-Role (ARN from account ID)&lt;br&gt;3. terraform init — S3 backend from the YAML&lt;br&gt;4. terraform plan / apply / destroy&lt;br&gt;&lt;br&gt;AWS units: GitHub-hosted runners&lt;br&gt;cluster units: phoenix-mgmt runner (private EKS)&lt;br&gt;&lt;br&gt;sandbox: module_ref = main&lt;br&gt;stage / UAT / prod: release tag (v0.1.0 …)&lt;br&gt;no Terragrunt · no helper scripts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingLeft=60;" vertex="1" parent="1"><mxGeometry x="900" y="640" width="400" height="330" as="geometry"/></mxCell><mxCell id="c28" value="" style="verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;shape=image;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="914" y="652" width="28" height="28" as="geometry"/></mxCell><mxCell id="c29" value="" style="verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;shape=image;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="914" y="690" width="28" height="28" as="geometry"/></mxCell><mxCell id="c30" value="AWS Cloud" style="points=[];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="1420" y="110" width="1160" height="1360" as="geometry"/></mxCell><mxCell id="c31" value="Group account (one per group) — e.g. research" style="points=[];outlineConnect=0;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="1440" y="150" width="1120" height="950" as="geometry"/></mxCell><mxCell id="c32" value="IAM deploy role&lt;br&gt;trusts GitHub OIDC" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=none;fillColor=#DD344C;pointerEvents=1;shape=mxgraph.aws4.role;" vertex="1" parent="1"><mxGeometry x="1480" y="200" width="56" height="56" as="geometry"/></mxCell><mxCell id="c33" value="S3 state bucket&lt;br&gt;one state per unit" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=#ffffff;fillColor=#7AA116;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="1640" y="200" width="56" height="56" as="geometry"/></mxCell><mxCell id="c34" value="KMS&lt;br&gt;state key" style="sketch=0;outlineConnect=0;dashed=0;fontStyle=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontColor=#232F3E;aspect=fixed;strokeColor=#ffffff;fillColor=#DD344C;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1"><mxGeometry x="1800" y="200" width="56" height="56" as="geometry"/></mxCell><mxCell i